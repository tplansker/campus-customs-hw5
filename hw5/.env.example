# Copy to .env and fill in values. Never commit .env.
# (The app also picks up a .env in a parent folder, e.g. "AI FOUNDATIONS/.env".)
PORTKEY_API_KEY=
OPENAI_MODEL=gpt-6-luna   # every agent uses this one model, routed through Portkey
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Working database used by BOTH the MCP server and the FastAPI backend.
# data/campus_customs.db is the pristine original and is never written.
CAMPUS_DB_PATH=data/campus_customs_new.db

MCP_PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp
BACKEND_PORT=8000
